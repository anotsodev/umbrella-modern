// Prisma schema for umbrella-modern.
//
// This is the empty/stub bootstrap for Phase 0. Every table listed in
// the §3 "Proposed web schema (Postgres)" section of
// dev-docs/spec.md is represented here so `prisma db push` works against
// a fresh Postgres container. None of the tables are populated yet —
// the umbrella-content import job lands in Phase 1.
//
// Conventions:
// - snake_case at the DB level (Prisma @map for tables/columns)
// - PascalCase model names, camelCase fields (Prisma convention)
// - All FKs ON DELETE behavior explicit; no implicit cascades
// - JSONB fields use Json type; updated_at triggers wired in migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Languages ------------------------------------------------------------

model Language {
  code       String   @id // e.g. "en", "ar", "es", "fa", "fr", "ru", "zh-Hant"
  name       String // e.g. "English"
  nativeName String   @map("native_name")
  rtl        Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  categories Category[]
  contents   Content[]
  checklists Checklist[]
  forms      Form[]

  @@map("languages")
}

// ---- Categories -----------------------------------------------------------

model Category {
  id         BigInt   @id @default(autoincrement())
  languageId String   @map("language_id")
  slug       String // e.g. "communications"
  title      String
  iconUrl    String?  @map("icon_url")
  position   Int      @default(0)
  parentId   BigInt?  @map("parent_id")
  createdAt  DateTime @default(now()) @map("created_at")

  language   Language    @relation(fields: [languageId], references: [code], onDelete: Cascade)
  parent     Category?   @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]  @relation("CategoryToParent")
  contents   Content[]
  checklists Checklist[]
  forms      Form[]

  @@unique([languageId, slug])
  @@index([parentId])
  @@index([languageId, position])
  @@map("categories")
}

// ---- Contents (topics + glossary terms) ----------------------------------

enum ContentType {
  topic
  glossary
}

model Content {
  id          BigInt      @id @default(autoincrement())
  languageId  String      @map("language_id")
  categoryId  BigInt      @map("category_id")
  slug        String
  title       String
  mdPath      String      @map("md_path") // e.g. "communications/s_encrypted-messengers.md"
  html        String      @db.Text // rendered HTML, populated by the import job
  frontmatter Json // YAML frontmatter as a JSON blob
  position    Int         @default(0)
  type        ContentType @default(topic)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  language Language @relation(fields: [languageId], references: [code], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([languageId, mdPath])
  @@index([categoryId, position])
  @@index([languageId, type])
  @@map("contents")
}

// ---- Checklists (pathways) -----------------------------------------------

model Checklist {
  id         BigInt   @id @default(autoincrement())
  slug       String
  categoryId BigInt   @map("category_id")
  languageId String   @map("language_id")
  title      String
  custom     Boolean  @default(false)
  ownerId    String?  @map("owner_id") // null for built-in checklists
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  category Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Language           @relation(fields: [languageId], references: [code], onDelete: Cascade)
  items    ChecklistItem[]
  runs     UserChecklistRun[]

  @@unique([languageId, slug])
  @@index([categoryId, position])
  @@map("checklists")
}

model ChecklistItem {
  id          BigInt   @id @default(autoincrement())
  checklistId BigInt   @map("checklist_id")
  position    Int
  label       String
  disabled    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  checklist Checklist               @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  progress  UserChecklistProgress[]

  @@index([checklistId, position])
  @@map("checklist_items")
}

// ---- User progress on checklists (Phase 2; tables exist for schema parity)

model UserChecklistRun {
  id          BigInt    @id @default(autoincrement())
  userId      String    @map("user_id")
  checklistId BigInt    @map("checklist_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  checklist Checklist               @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  progress  UserChecklistProgress[]

  @@index([userId, checklistId])
  @@map("user_checklist_runs")
}

model UserChecklistProgress {
  id        BigInt   @id @default(autoincrement())
  runId     BigInt   @map("run_id")
  itemId    BigInt   @map("item_id")
  checked   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  run  UserChecklistRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  item ChecklistItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([runId, itemId])
  @@map("user_checklist_progress")
}

// ---- Forms ---------------------------------------------------------------

model Form {
  id         BigInt   @id @default(autoincrement())
  categoryId BigInt   @map("category_id")
  languageId String   @map("language_id")
  slug       String
  title      String
  schema     Json // raw f_*.yml contents: screens → items w/ types
  createdAt  DateTime @default(now()) @map("created_at")

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language  Language   @relation(fields: [languageId], references: [code], onDelete: Cascade)
  userForms UserForm[]

  @@unique([languageId, slug])
  @@map("forms")
}

model UserForm {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id")
  formId    BigInt   @map("form_id")
  title     String
  answers   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([userId, formId])
  @@map("user_forms")
}

// ---- Users (better-auth: email + magic-link, no passwords) -------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]
  auditEntries  AuditLogEntry[]

  @@map("users")
}

model AuditLogEntry {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id")
  action    String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_log")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
