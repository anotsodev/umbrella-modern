# Copy this file to `.env` (Compose reads it automatically) and fill in real values.
# `.env` is gitignored. Never commit real secrets.

# --- App ---
NODE_ENV=development
# Hostname the app listens on inside the container. Do not change.
HOSTNAME=0.0.0.0
# Port the app listens on inside the container. Must match compose.yml `ports`.
PORT=3000

# --- Database ---
# Matches the credentials in compose.yml.
DATABASE_URL=postgresql://app:app@db:5432/app?schema=public

# --- i18n (next-intl) ---
# Comma-separated list of locales the app will serve. Mirrors the umbrella-content
# repo's language roots. The first entry is the default for unprefixed URLs.
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ar,es,fa,fr,ru,zh-Hant
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Placeholder hostname (replace when the real domain is set) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (better-auth) ---
# Generate with `openssl rand -base64 32`. Used to sign session cookies + magic-link tokens.
BETTER_AUTH_SECRET=replace-me-openssl-rand-base64-32
# Public base URL. Must match NEXT_PUBLIC_APP_URL in dev.
BETTER_AUTH_URL=http://localhost:3000

# --- Email transport (magic-link delivery) ---
# Provider: Resend (Phase 2+). https://resend.com/api-keys
# When unset AND NODE_ENV !== "production", magic-link delivery
# falls back to a console.log dev stub (look in the web container
# stdout). When unset AND NODE_ENV === "production", the app fails
# loud at send time rather than mailing nothing.
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. Format: "Name <addr@host>"
# Example for a self-hosted VPS with mail.example.org pointed at Resend:
#   EMAIL_FROM="Umbrella <noreply@example.org>"
EMAIL_FROM=
