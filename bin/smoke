#!/usr/bin/env bash
# Smoke test: bring the stack up, hit the app root.
# Idempotent: re-runs are safe; `docker compose up -d --wait` will not
# restart a healthy stack.

set -euo pipefail

ok()   { printf "  \033[32m✔\033[0m %s\n" "$1"; }
fail() { printf "  \033[31m✘\033[0m %s\n" "$1"; exit 1; }

echo "▶ bringing stack up"
docker compose up -d --wait

echo "▶ probing endpoints"
# Follow the next-intl middleware redirect from / to /<locale>.
status=$(curl -sL -o /dev/null -w "%{http_code}" http://localhost:3000 || echo "000")
if [ "$status" = "200" ]; then
  ok "/  -> 200 (followed redirect to /<locale>)"
else
  echo "  ✘ /  -> $status (expected 200)"
  docker compose logs web
  exit 1
fi

# /api/health is wired in Phase 0 once the health route is added.
# Until then, a 404 here is acceptable as long as the root returns 200.
api=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3000/api/health || echo "000")
if [ "$api" = "200" ] || [ "$api" = "404" ]; then
  ok "/api/health -> $api (404 OK until Phase 0 health route is added)"
else
  echo "  ✘ /api/health -> $api (expected 200 or 404)"
  docker compose logs web
  exit 1
fi

# Reader surface (Phase 1)
for url in /en /en/categories /en/categories/communications /en/search; do
  code=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:3000$url" || echo "000")
  if [ "$code" = "200" ]; then
    ok "$url -> 200"
  else
    echo "  ✘ $url -> $code (expected 200)"
    docker compose logs web
    exit 1
  fi
done

# FTS search returns 200 with results. Don't assert on a count
# because the corpus drifts with re-imports; just confirm 200.
search_code=$(curl -s -o /dev/null -w "%{http_code}" --get --data-urlencode "q=encryption" "http://localhost:3000/en/search" || echo "000")
if [ "$search_code" = "200" ]; then
  ok "/en/search?q=encryption -> 200"
else
  echo "  ✘ /en/search?q=encryption -> $search_code (expected 200)"
  docker compose logs web
  exit 1
fi

# Per-locale search smoke across all 7 languages
for loc in ar es fa fr ru zh-Hant; do
  code=$(curl -s -o /dev/null -w "%{http_code}" --get --data-urlencode "q=internet" "http://localhost:3000/$loc/search" || echo "000")
  if [ "$code" = "200" ]; then
    ok "/$loc/search?q=internet -> 200"
  else
    echo "  ✘ /$loc/search?q=internet -> $code (expected 200)"
    docker compose logs web
    exit 1
  fi
done

# Pathways (checklists) — index plus one per-locale detail page
for loc in en ar es fa fr ru zh-Hant; do
  code=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:3000/$loc/pathways" || echo "000")
  if [ "$code" = "200" ]; then
    ok "/$loc/pathways -> 200"
  else
    echo "  ✘ /$loc/pathways -> $code (expected 200)"
    docker compose logs web
    exit 1
  fi
done

# Pick a slug from the en pathways index, then probe a few
# locales for the same slug. We tolerate 404 if the locale
# hasn't shipped a translation of this checklist yet.
slug=$(curl -sL "http://localhost:3000/en/pathways" \
  | grep -oE 'href="/en/pathways/[^"]+"' \
  | head -1 \
  | sed -E 's|.*/pathways/([^"]+)".*|\1|')
if [ -n "$slug" ]; then
  ok "probing checklist slug: $slug"
  for loc in en ar fr; do
    code=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:3000/$loc/pathways/$slug" || echo "000")
    if [ "$code" = "200" ] || [ "$code" = "404" ]; then
      ok "/$loc/pathways/$slug -> $code (404 OK if not yet translated)"
    else
      echo "  ✘ /$loc/pathways/$slug -> $code (expected 200 or 404)"
      docker compose logs web
      exit 1
    fi
  done
fi
