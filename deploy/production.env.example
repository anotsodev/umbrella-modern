# Copy to .env.production (gitignored). Never commit real credentials.
# Passed explicitly: docker compose --env-file .env.production -f compose.prod.yml ...

# Fresh database: generate a long random password using hex (URL-safe).
# Existing database: MUST match its current app-role password. Setting this variable
# does not change the password in an existing Postgres volume.
POSTGRES_PASSWORD=

# Generate separately: openssl rand -hex 32
# For an existing site, preserve the current auth secret to keep sessions valid.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://umbrella.dnys.dev

# Required for production magic-link sign-in.
RESEND_API_KEY=
EMAIL_FROM="Umbrella <noreply@your-verified-domain.example>"

# Default: reachable only by a reverse proxy/tunnel on this host.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
